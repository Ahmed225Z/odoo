<odoo>
<record id="model_q_view_tree" model="ir.ui.view">
    <field name="name">model q tree</field>
    <field name="model">model.q</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="description"/>
            <field name="active"/>
        </list>
    </field>
</record>
<record id="model_q_view_form" model="ir.ui.view">
    <field name="name">model q form</field>
    <field name="model">model.q</field>
    <field name="arch" type="xml">
        <form>
        <sheet>
        <div class="oe_title">
        <label for="name"/>
        <h1>
            <field name="name"/>
        </h1>
        </div>
        <group>
        <group string="Model Q Information">
            <field name="active"/>
        </group>
        <group string="description">
            <field name="description"/>
        </group>
        </group>
        </sheet>
        </form>
    </field>
</record>
<record id="model_q_action" model="ir.actions.act_window">
    <field name="name">Model Q</field>
    <field name="res_model">model.q</field>
    <field name="view_mode">list,form</field>
</record>

<menuitem id="model_q_menu_item" 
          name="Model Q" 
          parent="Properties_menu"
          action="model_q_action"/>
</odoo>
