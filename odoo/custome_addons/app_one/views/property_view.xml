<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <list class="header_custom" multi_edit="1" create="1" edit="1" delete="1">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="state"/>
                <field name="date_availability"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="diff"/>
                <field name="garden"/>
                <field name="garden_area"/>
                <field name="postcode"/>
                <field name="bedrooms" optional="1"/>
            </list>
        </field>
    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_draft" string="To draft" type="object" class="btn btn-primary" invisible="state == 'draft'"/>
                        <button name="action_pending" string="To Pending" type="object" class="btn btn-secondary" invisible="state != 'draft'"/>
                        <button name="action_sold" string="To sold" type="object" class="btn btn-success" invisible="state != 'pending'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold"/>
                    </header>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Property Information">
                            <field name="date_availability"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="diff"/>
                            <field name="garden"/>
                            <field name="garden_area"/>
                            <field name="postcode"/>
                            <field name="bedrooms" optional="1"/>
                        </group>
                        <group string="Other Information">
                            <field name="owner_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="facades"/>
                            <field name="garage"/>
                            <field name="garden_orientation"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="property_action" model="ir.actions.act_window">
        <field name="name">property action</field>
        <field name="res_model">property</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="Properties_menu_item" 
              name="Properties" 
              parent="Properties_menu"
              action="property_action"/>
</odoo>