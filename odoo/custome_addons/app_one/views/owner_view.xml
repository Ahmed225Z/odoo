<odoo>

<record id="owner_view_tree" model="ir.ui.view">

    <field name="name">owner tree</field>

    <field name="model">owner</field>

    <field name="arch" type="xml">

        <list multi_edit="1" create="1" edit="1" delete="0">

            <field name="name"/>
            <field name="phone"/>
           
            <field name="address"/>
            

          

      

      

        </list>

    </field>

</record>

<record id="owner_view_form" model="ir.ui.view">

    <field name="name">owner form</field>

    <field name="model">owner</field>

    <field name="arch" type="xml">

        <form create="1" edit="1" delete="1">

        <sheet>

        <div class="oe_title">

        <label for="name"/>

        <h1>

            <field name="name"/>

        </h1>

        </div>

        <group>

        <group string="Owner Information">

            <field name="phone"/>
            <field name="property_ids" widget="many2many_tags"/>

            <field name="address"/>

            <field name="phone"/>
            
            
            
    

        </group>

    

        </group>

        </sheet>

      

        </form>

    </field>

</record>

<record id="owner_action" model="ir.actions.act_window">

    <field name="name">owner action</field>

    <field name="res_model">owner</field>

    <field name="view_mode">list,form</field>

</record>



<menuitem id="owner_menu_item" 

          name="Owner" 

          parent="configuration_menu"

          action="owner_action"/>

</odoo>